<%# An API key or passkey input. Every key field uses this, so they all look and behave the same.
    A text field masked with CSS, not type="password": a password field makes 1Password and Safari treat
    the form as a login and offer the Sherlock password, for the key and the fields around it. %>
<%# locals: (form:, field: :api_key, placeholder: "•" * 24, class: "", **options) %>
<%= form.text_field field, placeholder:, autocomplete: "off", spellcheck: false, autocapitalize: "none",
      data: { "1p-ignore": true, lpignore: true, bwignore: true, form_type: "other" },
      class: "input input-secret font-mono #{binding.local_variable_get(:class)}", **options %>
