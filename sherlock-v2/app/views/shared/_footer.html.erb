<% version = Rails.configuration.x.version %>
<footer class="hint px-6 py-6 text-center text-xs">
  <% if version == "unknown" %>
    Version unknown
  <% else %>
    Version <%= link_to version, "#{Rails.configuration.x.source_url}/releases/tag/#{version}", class: "font-mono hover:text-ink", target: "_blank", rel: "noopener" %>
  <% end %>
  · <%= link_to "Privacy", privacy_path, class: "hover:text-ink" %>
</footer>
