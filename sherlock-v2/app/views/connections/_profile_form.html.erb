<%# Connecting a tracker read with the instance key, in two steps: the member's profile link, then their
    opt-in link on that profile and Check. Used when adding a tracker and when joining with an open invite.
    continue: the button that saves it, shown once Check found everything Sherlock needs. %>
<%# locals: (sites:, claim:, profile_path:, check_path:, continue:, error: nil) %>
<% if claim.nil? %>
  <%= form_with url: profile_path, method: :post, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :profile_url, "Your profile link", class: "label" %>
      <%= form.text_field :profile_url, required: true, autofocus: true, autocomplete: "off", spellcheck: false,
            placeholder: "#{sites.first.base_url}/user.php?id=123", class: "input mt-1 font-mono" %>
      <p class="hint mt-1">Open your profile on <%= sites.map(&:name).to_sentence(last_word_connector: " or ", two_words_connector: " or ") %> and copy the address. Sherlock doesn't contact the tracker yet.</p>
    </div>
    <%= form.submit "Continue", class: "btn-primary" %>
  <% end %>
<% else %>
  <% site = claim.site %>
  <% link = "[url=#{opt_in_url(claim.profile_code)}]Stats tracked with Sherlock[/url]" %>
  <div class="card p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="font-medium">Add this to your <%= site.name %> profile</p>
        <p class="hint mt-1">Put it in the text of your profile and save. You can change the text, or use the bare address; only the address has to be somewhere on your profile. Keep it there: if you remove it, Sherlock stops tracking you.</p>
      </div>
      <%= button_to "Use another profile", profile_path, method: :delete, class: "btn-quiet shrink-0 text-xs" %>
    </div>
    <div class="mt-3 flex items-start gap-2" data-controller="clipboard" data-clipboard-text-value="<%= link %>">
      <code class="block flex-1 rounded-lg border border-line bg-sunken px-3 py-2 font-mono text-xs break-all text-ink"><%= link %></code>
      <button type="button" class="btn-secondary shrink-0" data-action="clipboard#copy"><i class="bi bi-clipboard"></i> Copy</button>
    </div>
    <p class="hint mt-2">Other <%= site.name %> members who open your profile will see the link.
      <%= link_to URI.join(site.base_url, "/user.php?id=#{claim.external_user_id}").to_s, class: "link", target: "_blank", rel: "noopener noreferrer" do %>Open my profile <i class="bi bi-box-arrow-up-right text-xs"></i><% end %></p>
  </div>

  <% if error %>
    <div class="mt-5 rounded-lg border border-down/30 bg-down-soft px-4 py-3 text-sm text-down" role="alert">
      <p class="font-medium"><%= error.message %></p>
      <% if error.is_a?(Engines::CheckNeeded) %><p class="mt-1 text-ink-soft">Save your profile on <%= site.name %>, then check again.</p><% end %>
    </div>
  <% end %>

  <% if claim.found? %>
    <div class="card mt-5 p-5">
      <p class="font-medium"><i class="bi bi-check-circle-fill text-up"></i> Found the link on <%= claim.external_username %>'s profile.</p>
      <%= render "connections/visibility", site:, stats: claim.stats %>
    </div>
  <% end %>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <% if claim.ready? %><%= continue %><% end %>
    <% unless claim.ready? && claim.hidden_stats.empty? %>
      <%= form_with url: check_path, method: :post, data: { controller: "submitting", submitting_label_value: "Checking your #{site.name} profile…" } do |form| %>
        <%= form.button class: claim.ready? ? "btn-secondary" : "btn-primary", data: { submitting_target: "button" } do %>
          <i class="bi bi-arrow-repeat inline-block animate-spin" data-submitting-target="spinner" hidden aria-hidden="true"></i>
          <span data-submitting-target="label"><%= claim.found? || error ? "Check again" : "Check" %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
