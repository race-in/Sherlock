<% content_for :title, "#{@connection.site.display_name} history" %>
<%= render "connections/header", connection: @connection, history: @history %>
<div class="mb-3 flex items-center justify-between">
  <p class="hint">
    One row per <%= @history.interval %>, newest first.
    <span class="tag-accent">Highlighted</span> rows uploaded more than your average <%= @history.interval %>.
  </p>
  <%= link_to connection_history_path(@connection, range: @history.range, format: :csv), class: "btn-secondary" do %><i class="bi bi-download"></i> CSV<% end %>
</div>
<section class="card overflow-x-auto">
  <% if @history.points.empty? %>
    <p class="hint px-4 py-10 text-center">No data for this range yet.</p>
  <% else %>
    <table class="table">
      <thead>
        <tr><th>Time</th><th class="text-right">Upload</th><th class="text-right">Download</th><th class="text-right">Buffer change</th><th class="text-right">Buffer</th><th class="text-right">Ratio</th><th class="text-right">Ratio this <%= @history.interval %></th></tr>
      </thead>
      <tbody>
        <% @rows.each do |point| %>
          <tr class="<%= "bg-accent-soft" if @history.above_average?(point) %>">
            <td class="num whitespace-nowrap"><%= l point.time, format: @history.interval == :hour ? "%a %d %b, %H:%M" : "%a %d %b %Y" %></td>
            <td class="text-right"><%= point.delta(:uploaded) ? byte_change(point.delta(:uploaded)) : tag.span("—", class: "text-muted") %></td>
            <td class="text-right"><%= bytes point.delta(:downloaded) %></td>
            <td class="text-right"><%= byte_change point.delta(:buffer) %></td>
            <td class="text-right"><%= bytes point[:buffer] %></td>
            <td class="text-right"><%= ratio point[:ratio] %></td>
            <td class="text-right"><%= ratio point.interval_ratio %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
<% if @pages > 1 %>
  <nav class="mt-3 flex items-center justify-between gap-3" aria-label="Pages">
    <% if @page > 1 %>
      <%= link_to connection_history_path(@connection, range: @history.range, page: @page - 1), class: "btn-secondary", rel: "prev" do %><i class="bi bi-chevron-left"></i> Newer<% end %>
    <% else %>
      <span></span>
    <% end %>
    <p class="hint">Page <%= @page %> of <%= @pages %></p>
    <% if @page < @pages %>
      <%= link_to connection_history_path(@connection, range: @history.range, page: @page + 1), class: "btn-secondary", rel: "next" do %>Older <i class="bi bi-chevron-right"></i><% end %>
    <% else %>
      <span></span>
    <% end %>
  </nav>
<% end %>
