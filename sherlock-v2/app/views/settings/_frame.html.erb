<% content_for :title, "Settings" %>
<h1 class="heading mb-6 text-3xl">Settings</h1>
<div class="flex flex-col gap-6 md:flex-row">
  <nav class="flex shrink-0 gap-0.5 overflow-x-auto md:w-44 md:flex-col" aria-label="Settings">
    <% [ [ "Trackers", settings_connections_path, "hdd-stack" ], ([ "qui", settings_qui_connections_path, "arrow-left-right" ] if Integration.qui.available_to?(Current.user)),
         [ "Preferences", edit_settings_preferences_path, "sliders" ], [ "Invites", settings_invites_path, "envelope-paper" ],
         [ "Account", settings_account_path, "person" ], [ "Data", settings_data_path, "database" ],
         [ "Developer", settings_developer_path, "code-slash" ] ].compact.each do |label, path, icon| %>
      <%= nav_link label, path, icon:, active: request.path.start_with?(path) || (path == settings_account_path && request.path == edit_password_path) %>
    <% end %>
  </nav>
  <div class="min-w-0 flex-1"><%= yield %></div>
</div>
