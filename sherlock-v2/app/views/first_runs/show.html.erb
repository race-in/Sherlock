<% content_for :title, "Set up Sherlock" %>
<div class="mx-auto max-w-sm" data-controller="time-zone">
  <h1 class="heading text-3xl">Set up Sherlock</h1>
  <p class="mt-2 text-ink-soft">Create the first account. It's the admin: it can invite people and reset their passwords.</p>
  <%= form_with model: @user, scope: :user, url: first_run_path, class: "mt-6 space-y-4" do |form| %>
    <%= render "shared/errors", record: form.object %>
    <%= form.hidden_field :time_zone, value: form.object.time_zone, data: { time_zone_target: "field" } %>
    <div>
      <%= form.label :username, class: "label" %>
      <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", class: "input mt-1" %>
      <p class="hint mt-1">Letters, numbers, dots, dashes and underscores.</p>
    </div>
    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72, class: "input mt-1" %>
      <p class="hint mt-1">At least 10 characters. There is no email reset, so keep it somewhere safe.</p>
    </div>
    <%= form.submit "Create admin account", class: "btn-primary w-full" %>
    <p class="hint text-center">No email, no IP address. Sherlock keeps your username, a hash of your password and your stats.</p>
  <% end %>
</div>
