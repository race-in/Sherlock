<!DOCTYPE html>
<html lang="en" data-theme="<%= Current.user&.theme || "system" %>">
  <head>
    <%= render "shared/head" %>
  </head>
  <body class="min-h-screen">
    <%= render "shared/topbar", home: root_path %>
    <div class="mx-auto flex max-w-2xl flex-col px-4 py-8 sm:px-6 sm:py-12">
      <main class="flex-1">
        <%= yield %>
      </main>
      <%= render "shared/footer" %>
    </div>
    <%= render "shared/toasts" %>
  </body>
</html>
