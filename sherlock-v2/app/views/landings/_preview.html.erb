<%# A drawn sample of the dashboard for the landing page: made-up numbers and no tracker names, in the
    theme's own colors. The lines draw in once, the bars grow, and the newest point pulses (application.css,
    .preview-*). With reduced motion it is still. %>
<% uploaded = [ 10, 11, 13, 13, 16, 20, 21, 22, 22, 25, 30, 34, 35, 36, 40, 41, 41, 45, 52, 55, 57, 58, 60, 66, 70, 71, 74, 80, 84, 90 ] %>
<% downloaded = [ 8, 9, 9, 10, 11, 11, 12, 14, 14, 15, 16, 16, 17, 19, 19, 20, 21, 21, 22, 24, 25, 25, 26, 27, 28, 30, 31, 31, 32, 34 ] %>
<% x = ->(i) { (i * 600.0 / (uploaded.size - 1)).round(1) } %>
<% y = ->(value) { (150 - value * 1.5).round(1) } %>
<% line = ->(values) { values.each_with_index.map { |value, i| "#{i.zero? ? "M" : "L"}#{x.(i)},#{y.(value)}" }.join(" ") } %>
<% daily = uploaded.each_cons(2).map { _2 - _1 } %>
<figure class="card overflow-hidden" aria-label="A sample Sherlock dashboard with made-up numbers">
  <div class="grid grid-cols-3 divide-x divide-line border-b border-line" aria-hidden="true">
    <% [ [ "Buffer", "+56 GiB", "30 days" ], [ "Ratio", "2.65", "from 1.25" ], [ "Uploaded", "+14.2 GiB", "this week" ] ].each do |label, value, note| %>
      <div class="min-w-0 px-3 py-3 sm:px-5">
        <p class="eyebrow"><%= label %></p>
        <p class="num mt-1 whitespace-nowrap text-base font-medium text-ink sm:text-xl"><%= value %></p>
        <p class="hint flex items-center gap-1 whitespace-nowrap text-xs"><i class="bi bi-arrow-up-right text-up"></i><%= note %></p>
      </div>
    <% end %>
  </div>
  <div class="px-4 pt-4 sm:px-5" aria-hidden="true">
    <div class="flex items-center gap-4 text-xs text-ink-soft">
      <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent"></span>Uploaded</span>
      <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-muted"></span>Downloaded</span>
      <span class="ml-auto text-muted">Sample data</span>
    </div>
    <svg viewBox="-6 -6 612 212" class="mt-2 block h-auto w-full overflow-visible">
      <% [ 0, 50, 100, 150 ].each do |grid| %>
        <line x1="0" x2="600" y1="<%= grid %>" y2="<%= grid %>" class="stroke-line" stroke-dasharray="3 5" />
      <% end %>
      <path d="<%= line.(uploaded) %> L600,150 L0,150 Z" class="preview-fade fill-accent/10" />
      <path d="<%= line.(downloaded) %>" pathLength="1" class="preview-line fill-none stroke-muted" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
      <path d="<%= line.(uploaded) %>" pathLength="1" class="preview-line fill-none stroke-accent" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
      <% daily.each_with_index do |delta, i| %>
        <rect x="<%= (x.(i + 1) - 6).round(1) %>" y="<%= 200 - delta * 4 %>" width="12" height="<%= delta * 4 %>" rx="2"
          class="preview-bar fill-accent/35" style="--i: <%= i %>" />
      <% end %>
      <circle cx="600" cy="<%= y.(uploaded.last) %>" r="6" class="preview-ping fill-accent" />
      <circle cx="600" cy="<%= y.(uploaded.last) %>" r="4" class="preview-fade fill-accent stroke-surface" stroke-width="2" />
    </svg>
  </div>
  <figcaption class="hint border-t border-line px-4 py-3 text-xs sm:px-5">Once an hour, a new point. The bars show how much you uploaded each day.</figcaption>
</figure>
