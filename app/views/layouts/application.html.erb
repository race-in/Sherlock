<!DOCTYPE html>
<html lang="en" data-theme="<%= Current.user.theme %>">
  <head>
    <%= render "shared/head" %>
  </head>
  <body class="min-h-screen" data-controller="menu" data-action="keydown.esc->menu#close">
    <%= turbo_stream_from Current.user if Current.user %>
    <%= render "shared/topbar", home: dashboard_path, menu: true %>
    <div id="menu" class="fixed inset-x-0 top-topbar bottom-0 z-20 hidden flex-col overflow-y-auto bg-sunken px-3 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] md:hidden!"
         data-menu-target="panel">
      <%= render "layouts/nav" %>
      <div class="mt-3 flex items-center justify-between gap-3 border-t border-line px-2.5 pt-3 text-sm">
        <span class="truncate text-muted"><%= Current.user.username %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "btn-quiet cursor-pointer" %>
      </div>
    </div>
    <div class="flex min-h-[calc(100vh-var(--topbar-h))]">
      <aside class="sticky top-topbar hidden h-[calc(100vh-var(--topbar-h))] w-60 shrink-0 flex-col border-r border-line bg-sunken px-3 py-4 md:flex">
        <%= render "layouts/nav" %>
      </aside>

      <div class="min-w-0 flex-1">
        <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
          <%= yield %>
        </main>
        <%= render "shared/footer" %>
      </div>
    </div>
    <%= render "shared/toasts" %>
  </body>
</html>
