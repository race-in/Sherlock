<%= render layout: "settings/frame" do %>
  <h2 class="section-title mb-3">Preferences</h2>
  <%= form_with model: Current.user, scope: :user, url: settings_preferences_path, method: :patch, class: "card max-w-2xl space-y-6 p-6", data: { controller: "time-zone", time_zone_overwrite_value: false } do |form| %>
    <%= render "shared/errors", record: Current.user %>
    <%= render "users/preference_fields", form:, full: true %>
    <%= form.submit "Save", class: "btn-primary" %>
  <% end %>
<% end %>
