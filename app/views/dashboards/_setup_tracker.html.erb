<%# The admin's first tracker, inside the setup on the dashboard: pick it, then the same setup as in
    Admin → Sites (admin/sites/setups/_form). Picking a tracker reloads only this frame. %>
<%# locals: (site:, share:, error:) %>
<%= turbo_frame_tag "first_tracker", data: { turbo_action: "advance" } do %>
  <% if site.nil? %>
    <div class="mt-4" data-controller="filter">
      <input type="search" placeholder="Search trackers" class="input max-w-xs" data-filter-target="query" data-action="input->filter#apply" aria-label="Search trackers">
      <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-3">
        <% Site.where.not(tier: :unsupported).order(:name).each do |choice| %>
          <%= link_to dashboard_path(setup_site: choice.slug), class: "card flex items-center gap-3 p-3 hover:border-accent",
                data: { filter_target: "item", name: choice.name.downcase } do %>
            <%= site_mark choice %>
            <span class="flex-1 font-medium"><%= choice.name %></span>
            <i class="bi bi-chevron-right text-muted" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="mt-4 flex items-center gap-3">
      <%= site_mark site, size: "size-8" %>
      <p class="text-lg font-medium"><%= site.name %></p>
      <%= link_to "Choose another tracker", dashboard_path, class: "btn-quiet ml-auto" %>
    </div>
    <%= render "admin/sites/setups/form", site:, share:, error:, from: "dashboard" %>
  <% end %>
<% end %>
